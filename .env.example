# Copiez ce fichier en .env.local puis renseignez les valeurs de votre projet Supabase
# (Supabase > Project Settings > API). Seule la clé PUBLIQUE (publishable / anon) va ici.
# Ne mettez JAMAIS la clé service_role dans le front.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
